# C0.25 stream compiler. A flat state-machine lexer records bounded tokens,
# then a checked statement/expression parser emits ELF64 directly.
fn main() {
    let got = input_read(0, 9985)
    let count = got
    let pos = 0
    let ch = 0
    let tokens = 0
    let kind = 0
    let value = 0
    let start = 0
    let ok = 1
    let state = 0
    let temp = 0
    let error = 0
    let status = 0
    let out = 0
    let active = 0
    let index = 0

    while got != 0 {
        got = input_read(count, 9985 - count)
        count = count + got
    }

    ok = count < 9985
    error = 9984 * (ok == 0)
    active = ok

    # Lexer states: 0=start, 1=identifier, 2=decimal integer. Token kind,
    # value, and 16-bit byte offset occupy four bounded parallel tables.
    while active * ok {
        ch = byte_load(pos)
        byte_store(13300, state == 0)
        byte_store(13301, state == 1)
        byte_store(13302, state == 2)
        byte_store(13303, pos == count)
        byte_store(13316, state == 3)
        byte_store(13317, state == 4)
        byte_store(13318, byte_load(13300) * (ch == 34) * (byte_load(13303) == 0))
        byte_store(13319, byte_load(13316) * (ch == 34) * (byte_load(13303) == 0))

        status = (ch == 32) + (ch == 9) + (ch == 10) + (ch == 13)
        byte_store(13304, status != 0)
        status = (ch < 91) * ((ch < 65) == 0)
        status = status + (ch < 123) * ((ch < 97) == 0)
        status = status + (ch == 95)
        byte_store(13305, status != 0)
        status = (ch < 58) * ((ch < 48) == 0)
        byte_store(13306, status)
        status = byte_load(13305) + byte_load(13306)
        byte_store(13307, status != 0)

        kind = 10 * (ch == 40)
        kind = kind + 11 * (ch == 41)
        kind = kind + 12 * (ch == 123)
        kind = kind + 13 * (ch == 125)
        kind = kind + 14 * (ch == 59)
        kind = kind + 15 * (ch == 43)
        kind = kind + 16 * (ch == 42)
        kind = kind + 17 * (ch == 45)
        kind = kind + 18 * (ch == 47)
        kind = kind + 19 * (ch == 61)
        kind = kind + 20 * (ch == 44)
        kind = kind * byte_load(13300) * (byte_load(13303) == 0)
        byte_store(13308, kind != 0)

        status = byte_load(13301) * (byte_load(13307) == 0)
        byte_store(13309, status)
        status = byte_load(13302) * (byte_load(13306) == 0)
        byte_store(13310, status)

        # Classify a completed identifier without a host string runtime.
        out = pos - start
        status = (out == 2) * (byte_load(start) == 102)
        status = status * (byte_load(start + 1) == 110)
        byte_store(13311, status)
        status = (out == 3) * (byte_load(start) == 108)
        status = status * (byte_load(start + 1) == 101)
        status = status * (byte_load(start + 2) == 116)
        byte_store(13312, status)
        status = (out == 4) * (byte_load(start) == 109)
        status = status * (byte_load(start + 1) == 97)
        status = status * (byte_load(start + 2) == 105)
        status = status * (byte_load(start + 3) == 110)
        byte_store(13313, status)
        status = (out == 6) * (byte_load(start) == 114)
        status = status * (byte_load(start + 1) == 101)
        status = status * (byte_load(start + 2) == 116)
        status = status * (byte_load(start + 3) == 117)
        status = status * (byte_load(start + 4) == 114)
        status = status * (byte_load(start + 5) == 110)
        byte_store(13314, status)
        status = (out == 5) * (byte_load(start) == 119)
        status = status * (byte_load(start + 1) == 114)
        status = status * (byte_load(start + 2) == 105)
        status = status * (byte_load(start + 3) == 116)
        status = status * (byte_load(start + 4) == 101)
        byte_store(13320, status)
        status = (out == 10) * (byte_load(start) == 105)
        status = status * (byte_load(start + 1) == 110)
        status = status * (byte_load(start + 2) == 112)
        status = status * (byte_load(start + 3) == 117)
        status = status * (byte_load(start + 4) == 116)
        status = status * (byte_load(start + 5) == 95)
        status = status * (byte_load(start + 6) == 114)
        status = status * (byte_load(start + 7) == 101)
        status = status * (byte_load(start + 8) == 97)
        status = status * (byte_load(start + 9) == 100)
        byte_store(13321, status)
        status = (out == 10) * (byte_load(start) == 98)
        status = status * (byte_load(start + 1) == 121)
        status = status * (byte_load(start + 2) == 116)
        status = status * (byte_load(start + 3) == 101)
        status = status * (byte_load(start + 4) == 95)
        status = status * (byte_load(start + 5) == 115)
        status = status * (byte_load(start + 6) == 116)
        status = status * (byte_load(start + 7) == 111)
        status = status * (byte_load(start + 8) == 114)
        status = status * (byte_load(start + 9) == 101)
        byte_store(13322, status)
        status = (out == 9) * (byte_load(start) == 98)
        status = status * (byte_load(start + 1) == 121)
        status = status * (byte_load(start + 2) == 116)
        status = status * (byte_load(start + 3) == 101)
        status = status * (byte_load(start + 4) == 95)
        status = status * (byte_load(start + 5) == 108)
        status = status * (byte_load(start + 6) == 111)
        status = status * (byte_load(start + 7) == 97)
        status = status * (byte_load(start + 8) == 100)
        byte_store(13323, status)
        status = (out == 5) * (byte_load(start) == 119)
        status = status * (byte_load(start + 1) == 104)
        status = status * (byte_load(start + 2) == 105)
        status = status * (byte_load(start + 3) == 108)
        status = status * (byte_load(start + 4) == 101)
        byte_store(13378, status)
        status = (out == 12) * (byte_load(start) == 111)
        status = status * (byte_load(start + 1) == 117)
        status = status * (byte_load(start + 2) == 116)
        status = status * (byte_load(start + 3) == 112)
        status = status * (byte_load(start + 4) == 117)
        status = status * (byte_load(start + 5) == 116)
        status = status * (byte_load(start + 6) == 95)
        status = status * (byte_load(start + 7) == 119)
        status = status * (byte_load(start + 8) == 114)
        status = status * (byte_load(start + 9) == 105)
        status = status * (byte_load(start + 10) == 116)
        status = status * (byte_load(start + 11) == 101)
        byte_store(13393, status)
        status = (out == 17) * (byte_load(start) == 98)
        status = status * (byte_load(start + 1) == 121)
        status = status * (byte_load(start + 2) == 116)
        status = status * (byte_load(start + 3) == 101)
        status = status * (byte_load(start + 4) == 95)
        status = status * (byte_load(start + 5) == 97)
        status = status * (byte_load(start + 6) == 115)
        status = status * (byte_load(start + 7) == 115)
        status = status * (byte_load(start + 8) == 101)
        status = status * (byte_load(start + 9) == 114)
        status = status * (byte_load(start + 10) == 116)
        status = status * (byte_load(start + 11) == 95)
        status = status * (byte_load(start + 12) == 114)
        status = status * (byte_load(start + 13) == 97)
        status = status * (byte_load(start + 14) == 110)
        status = status * (byte_load(start + 15) == 103)
        status = status * (byte_load(start + 16) == 101)
        byte_store(13399, status)
        status = (out == 13) * (byte_load(start) == 98)
        status = status * (byte_load(start + 1) == 121)
        status = status * (byte_load(start + 2) == 116)
        status = status * (byte_load(start + 3) == 101)
        status = status * (byte_load(start + 4) == 95)
        status = status * (byte_load(start + 5) == 112)
        status = status * (byte_load(start + 6) == 97)
        status = status * (byte_load(start + 7) == 114)
        status = status * (byte_load(start + 8) == 115)
        status = status * (byte_load(start + 9) == 101)
        status = status * (byte_load(start + 10) == 95)
        status = status * (byte_load(start + 11) == 117)
        status = status * (byte_load(start + 12) == 56)
        byte_store(13426, status)
        status = (out == 18) * (byte_load(start) == 98)
        status = status * (byte_load(start + 1) == 121)
        status = status * (byte_load(start + 2) == 116)
        status = status * (byte_load(start + 3) == 101)
        status = status * (byte_load(start + 4) == 95)
        status = status * (byte_load(start + 5) == 112)
        status = status * (byte_load(start + 6) == 97)
        status = status * (byte_load(start + 7) == 114)
        status = status * (byte_load(start + 8) == 115)
        status = status * (byte_load(start + 9) == 101)
        status = status * (byte_load(start + 10) == 95)
        status = status * (byte_load(start + 11) == 117)
        status = status * (byte_load(start + 12) == 56)
        status = status * (byte_load(start + 13) == 95)
        status = status * (byte_load(start + 14) == 116)
        status = status * (byte_load(start + 15) == 104)
        status = status * (byte_load(start + 16) == 101)
        status = status * (byte_load(start + 17) == 110)
        byte_store(13427, status)
        status = (out == 16) * (byte_load(start) == 98)
        status = status * (byte_load(start + 1) == 121)
        status = status * (byte_load(start + 2) == 116)
        status = status * (byte_load(start + 3) == 101)
        status = status * (byte_load(start + 4) == 95)
        status = status * (byte_load(start + 5) == 112)
        status = status * (byte_load(start + 6) == 97)
        status = status * (byte_load(start + 7) == 114)
        status = status * (byte_load(start + 8) == 115)
        status = status * (byte_load(start + 9) == 101)
        status = status * (byte_load(start + 10) == 95)
        status = status * (byte_load(start + 11) == 115)
        status = status * (byte_load(start + 12) == 116)
        status = status * (byte_load(start + 13) == 109)
        status = status * (byte_load(start + 14) == 116)
        status = status * (byte_load(start + 15) == 115)
        byte_store(13438, status)
        status = (out == 12) * (byte_load(start) == 98)
        status = status * (byte_load(start + 1) == 121)
        status = status * (byte_load(start + 2) == 116)
        status = status * (byte_load(start + 3) == 101)
        status = status * (byte_load(start + 4) == 95)
        status = status * (byte_load(start + 5) == 108)
        status = status * (byte_load(start + 6) == 111)
        status = status * (byte_load(start + 7) == 97)
        status = status * (byte_load(start + 8) == 100)
        status = status * (byte_load(start + 9) == 95)
        status = status * (byte_load(start + 10) == 97)
        status = status * (byte_load(start + 11) == 116)
        byte_store(13446, status)
        status = (out == 13) * (byte_load(start) == 98)
        status = status * (byte_load(start + 1) == 121)
        status = status * (byte_load(start + 2) == 116)
        status = status * (byte_load(start + 3) == 101)
        status = status * (byte_load(start + 4) == 95)
        status = status * (byte_load(start + 5) == 115)
        status = status * (byte_load(start + 6) == 116)
        status = status * (byte_load(start + 7) == 111)
        status = status * (byte_load(start + 8) == 114)
        status = status * (byte_load(start + 9) == 101)
        status = status * (byte_load(start + 10) == 95)
        status = status * (byte_load(start + 11) == 97)
        status = status * (byte_load(start + 12) == 116)
        byte_store(13447, status)
        status = (out == 19) * (byte_load(start) == 98)
        status = status * (byte_load(start + 1) == 121)
        status = status * (byte_load(start + 2) == 116)
        status = status * (byte_load(start + 3) == 101)
        status = status * (byte_load(start + 4) == 95)
        status = status * (byte_load(start + 5) == 99)
        status = status * (byte_load(start + 6) == 108)
        status = status * (byte_load(start + 7) == 97)
        status = status * (byte_load(start + 8) == 115)
        status = status * (byte_load(start + 9) == 115)
        status = status * (byte_load(start + 10) == 105)
        status = status * (byte_load(start + 11) == 102)
        status = status * (byte_load(start + 12) == 121)
        status = status * (byte_load(start + 13) == 95)
        status = status * (byte_load(start + 14) == 97)
        status = status * (byte_load(start + 15) == 115)
        status = status * (byte_load(start + 16) == 99)
        status = status * (byte_load(start + 17) == 105)
        status = status * (byte_load(start + 18) == 105)
        byte_store(13466, status)
        status = (out == 15) * (byte_load(start) == 98)
        status = status * (byte_load(start + 1) == 121)
        status = status * (byte_load(start + 2) == 116)
        status = status * (byte_load(start + 3) == 101)
        status = status * (byte_load(start + 4) == 95)
        status = status * (byte_load(start + 5) == 116)
        status = status * (byte_load(start + 6) == 111)
        status = status * (byte_load(start + 7) == 107)
        status = status * (byte_load(start + 8) == 101)
        status = status * (byte_load(start + 9) == 110)
        status = status * (byte_load(start + 10) == 95)
        status = status * (byte_load(start + 11) == 112)
        status = status * (byte_load(start + 12) == 117)
        status = status * (byte_load(start + 13) == 115)
        status = status * (byte_load(start + 14) == 104)
        byte_store(13476, status)

        index = 4
        index = index * (byte_load(13311) == 0) + byte_load(13311)
        index = index * (byte_load(13312) == 0) + 6 * byte_load(13312)
        index = index * (byte_load(13313) == 0) + 2 * byte_load(13313)
        index = index * (byte_load(13314) == 0) + 3 * byte_load(13314)
        index = index * (byte_load(13320) == 0) + 7 * byte_load(13320)
        index = index * (byte_load(13321) == 0) + 8 * byte_load(13321)
        index = index * (byte_load(13322) == 0) + 21 * byte_load(13322)
        index = index * (byte_load(13323) == 0) + 22 * byte_load(13323)
        index = index * (byte_load(13378) == 0) + 23 * byte_load(13378)
        index = index * (byte_load(13393) == 0) + 24 * byte_load(13393)
        index = index * (byte_load(13399) == 0) + 25 * byte_load(13399)
        index = index * (byte_load(13426) == 0) + 26 * byte_load(13426)
        index = index * (byte_load(13427) == 0) + 27 * byte_load(13427)
        index = index * (byte_load(13438) == 0) + 28 * byte_load(13438)
        index = index * (byte_load(13446) == 0) + 29 * byte_load(13446)
        index = index * (byte_load(13447) == 0) + 30 * byte_load(13447)
        index = index * (byte_load(13466) == 0) + 31 * byte_load(13466)
        index = index * (byte_load(13476) == 0) + 32 * byte_load(13476)
        kind = kind + index * byte_load(13309) + 5 * byte_load(13310)
        kind = kind + 9 * byte_load(13319)
        status = kind != 0
        byte_store(13315, status)

        # A punctuation token starts at the current byte.
        status = byte_load(13308)
        start = start * (status == 0) + pos * status

        # Store only emitted tokens; non-emitting iterations target scratch.
        # Six 512-byte tables start at 16000 so 16-bit offset/length halves
        # remain disjoint through the 512-token bound.
        status = byte_load(13315)
        index = status == 0
        byte_store(16000 + tokens * status + 12000 * index, kind)
        byte_store(16512 + tokens * status + 12001 * index, value)
        temp = start / 256
        byte_store(17024 + tokens * status + 12002 * index, start - temp * 256)
        byte_store(17536 + tokens * status + 12003 * index, temp)
        got = out * (byte_load(13308) == 0) * (byte_load(13319) == 0)
        got = got + byte_load(13308) + (out + 1) * byte_load(13319)
        temp = got / 256
        byte_store(18048 + tokens * status + 12004 * index, got - temp * 256)
        byte_store(18560 + tokens * status + 12005 * index, temp)

        out = status * ((tokens < 512) == 0)
        error = error * (out == 0) + start * out
        ok = ok * (out == 0)
        tokens = tokens + status

        # Enter a new word/number after any completed token was recorded.
        out = byte_load(13300) * (byte_load(13305) + byte_load(13306))
        out = out + byte_load(13318)
        start = start * (out == 0) + pos * out

        index = byte_load(13302) * byte_load(13306)
        status = byte_load(13300) * byte_load(13306)
        got = value * 10 + ch - 48
        value = value * ((index + status) == 0)
        value = value + got * index
        value = value + (ch - 48) * status
        out = (index + status) * ((value < 256) == 0)
        error = error * (out == 0) + start * out
        ok = ok * (out == 0)

        state = byte_load(13301) * byte_load(13307)
        state = state + 2 * byte_load(13302) * byte_load(13306)
        state = state + byte_load(13300) * byte_load(13305)
        state = state + 2 * byte_load(13300) * byte_load(13306)
        state = state + 3 * byte_load(13318)
        status = byte_load(13316) * (byte_load(13303) == 0)
        state = state + 3 * status * (ch != 34) * (ch != 92)
        state = state + 4 * status * (ch == 92)
        state = state + 3 * byte_load(13317) * (byte_load(13303) == 0)

        out = byte_load(13300) * byte_load(13304)
        out = out + byte_load(13300) * byte_load(13305)
        out = out + byte_load(13300) * byte_load(13306)
        out = out + byte_load(13308)
        out = out + byte_load(13301) * byte_load(13307)
        out = out + byte_load(13302) * byte_load(13306)
        out = out + byte_load(13318)
        out = out + byte_load(13316) * (byte_load(13303) == 0)
        out = out + byte_load(13317) * (byte_load(13303) == 0)
        pos = pos + out

        status = byte_load(13300) * (byte_load(13303) == 0)
        status = status * ((byte_load(13304) + byte_load(13305) + byte_load(13306) + byte_load(13308) + byte_load(13318)) == 0)
        got = (byte_load(13316) + byte_load(13317)) * byte_load(13303)
        error = error * ((status + got) == 0) + pos * status + start * got
        status = (status + got) != 0
        ok = ok * (status == 0)
        active = active * ((byte_load(13300) * byte_load(13303)) == 0) * ok
    }

    # Fixed function prefix: fn main ( ) {
    byte_store(13200, 1)
    byte_store(13201, 2)
    byte_store(13202, 10)
    byte_store(13203, 11)
    byte_store(13204, 12)
    pos = 0
    index = 0
    while (index < 5) * ok {
        active = pos < tokens
        kind = byte_load(16000 + pos) * active
        temp = byte_load(17536 + pos)
        start = (byte_load(17024 + pos) + temp * 256) * active
        start = start + count * (active == 0)
        status = kind == byte_load(13200 + index)
        error = error * status + start * (status == 0)
        ok = ok * status
        pos = pos + status
        index = index + status
    }

    # Statement states: 0=statement, 1=local name, 2='=', 3=factor,
    # 4=operator/end, 5=multiplication rhs, 6=closing brace, 7..10=write call,
    # 11..14=bounded string decoding, 15..19=input_read, 20..24=byte_store,
    # 25..27=byte_load return factor, 28=optional call separator,
    # 29..34=dynamic byte assignment, 35..39=one non-nested while, and
    # 40..44=dynamic output_write, 45..51=byte_assert_range, and
    # 52..56=byte_parse_u8, 57..63=byte_parse_u8_then, and
    # 64..68=byte_parse_stmts, 69..73=byte_load_at, and
    # 74..78=byte_store_at, 79..83=byte_classify_ascii, and
    # 84..90=byte_token_push.
    # Bootstrap local names are one lowercase ASCII byte so lookup remains
    # direct and collision-free.
    value = 0
    temp = 0
    state = 0
    byte_store(13080, 0)
    byte_store(13081, 0)
    byte_store(13082, 0)
    byte_store(13083, 0)
    byte_store(13084, 0)
    byte_store(13085, 0)
    byte_store(13086, 0)
    byte_store(13087, 0)
    byte_store(13088, 0)
    byte_store(13089, 0)
    byte_store(13090, 0)
    byte_store(13091, 0)
    byte_store(13092, 0)
    byte_store(13093, 0)
    byte_store(13094, 0)
    byte_store(13095, 0)
    byte_store(13096, 0)
    byte_store(13097, 0)
    byte_store(13098, 0)
    byte_store(13099, 0)
    byte_store(13100, 0)
    byte_store(13101, 0)
    byte_store(13102, 0)
    byte_store(13103, 0)
    byte_store(13104, 0)
    byte_store(13105, 0)
    byte_store(13106, 0)
    byte_store(13107, 0)
    byte_store(13108, 0)
    byte_store(13110, 0)
    byte_store(13111, 0)
    byte_store(13112, 0)
    byte_store(13113, 0)
    active = ok
    while active * ok {
        out = pos < tokens
        kind = byte_load(16000 + pos) * out
        ch = byte_load(16512 + pos)
        index = byte_load(17536 + pos)
        start = (byte_load(17024 + pos) + index * 256) * out
        start = start + count * (out == 0)

        got = (byte_load(18048 + pos) + byte_load(18560 + pos) * 256) * out
        byte_store(13350, byte_load(18048 + pos) * out)
        byte_store(13351, byte_load(18560 + pos) * out)
        index = byte_load(start)
        byte_store(13334, index)
        status = (kind == 4) * (got == 1)
        status = status * ((index < 97) == 0) * (index < 123)
        byte_store(13330, status)
        status = status * byte_load(13700 + index)
        byte_store(13331, status)
        status = (kind == 5) + byte_load(13331)
        byte_store(13332, status != 0)
        got = ch * (kind == 5) + byte_load(13400 + index) * byte_load(13331)
        byte_store(13333, got)

        status = byte_load(13099) == 0
        byte_store(13320, (state == 0) * (kind == 6) * status)
        byte_store(13321, (state == 0) * (kind == 3) * status)
        status = byte_load(13330) * (byte_load(13700 + index) == 0)
        status = status * (byte_load(13082) < 8)
        byte_store(13322, (state == 1) * status)
        byte_store(13323, (state == 2) * (kind == 19))
        byte_store(13324, (state == 3) * byte_load(13332))
        byte_store(13325, (state == 5) * byte_load(13332))
        status = byte_load(13090) == 0
        byte_store(13326, (state == 4) * (kind == 16) * status)
        byte_store(13327, (state == 4) * (kind == 15) * status)

        status = kind == 14
        got = (kind == 6) + (kind == 3) + (kind == 13) + (out == 0)
        status = status + (byte_load(13080) == 1) * (got != 0)
        status = status + (byte_load(13080) == 2) * (kind == 13)
        byte_store(13328, (state == 4) * (status != 0))
        byte_store(13329, (state == 6) * (kind == 13))

        byte_store(13335, (state == 0) * (kind == 7))
