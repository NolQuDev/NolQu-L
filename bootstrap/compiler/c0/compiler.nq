        byte_store((out + 74) * state + 12200 * (state == 0), 108)
        byte_store((out + 75) * state + 12200 * (state == 0), 101)
        byte_store((out + 76) * state + 12200 * (state == 0), 100)
        byte_store((out + 77) * state + 12200 * (state == 0), 10)
        out = out + 78 * state

        # Resolve the signal-setup branch and every output operation branch to
        # the shared handler. All displacements are forward rel32 values.
        index = byte_load(13105) + byte_load(13106) * 256
        got = start - index - 4
        value = got / 256
        byte_store(index * state + 12200 * (state == 0), got - value * 256)
        got = value
        value = got / 256
        byte_store((index + 1) * state + 12200 * (state == 0), got - value * 256)
        got = value
        value = got / 256
        byte_store((index + 2) * state + 12200 * (state == 0), got - value * 256)
        got = value
        value = got / 256
        byte_store((index + 3) * state + 12200 * (state == 0), got - value * 256)

        active = 0
    }

    index = 0
    active = ok * byte_load(13096) * byte_load(13104) * (index < status)
    while active {
        kind = byte_load(10000 + index)
        ch = ((kind == 4) + (kind == 7)) != 0
        temp = byte_load(10160 + index) + byte_load(10200 + index) * 256
        got = start - temp - 4
        value = got / 256
        byte_store(temp * ch + 12200 * (ch == 0), got - value * 256)
        got = value
        value = got / 256
        byte_store((temp + 1) * ch + 12200 * (ch == 0), got - value * 256)
        got = value
        value = got / 256
        byte_store((temp + 2) * ch + 12200 * (ch == 0), got - value * 256)
        got = value
        value = got / 256
        byte_store((temp + 3) * ch + 12200 * (ch == 0), got - value * 256)
        index = index + 1
        active = ok * byte_load(13096) * byte_load(13104) * (index < status)
    }

    # Assertions branch to a separate user-input diagnostic. Its write loop
    # exits 1 even when stderr itself is unavailable, so rejection never turns
    # into success or recursive error reporting.
    active = ok * byte_load(13096) * byte_load(13113)
    while active {
        start = out
        state = byte_load(13113)
        byte_store(out * state + 12200 * (state == 0), 184)
        byte_store((out + 1) * state + 12200 * (state == 0), 1)
        byte_store((out + 5) * state + 12200 * (state == 0), 191)
        byte_store((out + 6) * state + 12200 * (state == 0), 2)
        byte_store((out + 10) * state + 12200 * (state == 0), 72)
        byte_store((out + 11) * state + 12200 * (state == 0), 141)
        byte_store((out + 12) * state + 12200 * (state == 0), 53)
        byte_store((out + 13) * state + 12200 * (state == 0), 32)
        byte_store((out + 17) * state + 12200 * (state == 0), 186)
        byte_store((out + 18) * state + 12200 * (state == 0), 24)
        byte_store((out + 22) * state + 12200 * (state == 0), 15)
        byte_store((out + 23) * state + 12200 * (state == 0), 5)
        byte_store((out + 24) * state + 12200 * (state == 0), 72)
        byte_store((out + 25) * state + 12200 * (state == 0), 133)
        byte_store((out + 26) * state + 12200 * (state == 0), 192)
        byte_store((out + 27) * state + 12200 * (state == 0), 126)
        byte_store((out + 28) * state + 12200 * (state == 0), 8)
        byte_store((out + 29) * state + 12200 * (state == 0), 72)
        byte_store((out + 30) * state + 12200 * (state == 0), 1)
        byte_store((out + 31) * state + 12200 * (state == 0), 198)
        byte_store((out + 32) * state + 12200 * (state == 0), 72)
        byte_store((out + 33) * state + 12200 * (state == 0), 41)
        byte_store((out + 34) * state + 12200 * (state == 0), 194)
        byte_store((out + 35) * state + 12200 * (state == 0), 117)
        byte_store((out + 36) * state + 12200 * (state == 0), 241)
        byte_store((out + 37) * state + 12200 * (state == 0), 191)
        byte_store((out + 38) * state + 12200 * (state == 0), 1)
        byte_store((out + 42) * state + 12200 * (state == 0), 184)
        byte_store((out + 43) * state + 12200 * (state == 0), 60)
        byte_store((out + 47) * state + 12200 * (state == 0), 15)
        byte_store((out + 48) * state + 12200 * (state == 0), 5)

        # "runtime: invalid source\n"
        byte_store((out + 49) * state + 12200 * (state == 0), 114)
        byte_store((out + 50) * state + 12200 * (state == 0), 117)
        byte_store((out + 51) * state + 12200 * (state == 0), 110)
        byte_store((out + 52) * state + 12200 * (state == 0), 116)
        byte_store((out + 53) * state + 12200 * (state == 0), 105)
        byte_store((out + 54) * state + 12200 * (state == 0), 109)
        byte_store((out + 55) * state + 12200 * (state == 0), 101)
        byte_store((out + 56) * state + 12200 * (state == 0), 58)
        byte_store((out + 57) * state + 12200 * (state == 0), 32)
        byte_store((out + 58) * state + 12200 * (state == 0), 105)
        byte_store((out + 59) * state + 12200 * (state == 0), 110)
        byte_store((out + 60) * state + 12200 * (state == 0), 118)
        byte_store((out + 61) * state + 12200 * (state == 0), 97)
        byte_store((out + 62) * state + 12200 * (state == 0), 108)
        byte_store((out + 63) * state + 12200 * (state == 0), 105)
        byte_store((out + 64) * state + 12200 * (state == 0), 100)
        byte_store((out + 65) * state + 12200 * (state == 0), 32)
        byte_store((out + 66) * state + 12200 * (state == 0), 115)
        byte_store((out + 67) * state + 12200 * (state == 0), 111)
        byte_store((out + 68) * state + 12200 * (state == 0), 117)
        byte_store((out + 69) * state + 12200 * (state == 0), 114)
        byte_store((out + 70) * state + 12200 * (state == 0), 99)
        byte_store((out + 71) * state + 12200 * (state == 0), 101)
        byte_store((out + 72) * state + 12200 * (state == 0), 10)
        out = out + 73 * state
        active = 0
    }

    index = 0
    active = ok * byte_load(13096) * byte_load(13113) * (index < status)
    while active {
        kind = byte_load(10000 + index)
        ch = ((kind == 8) + (kind == 9) + (kind == 10) + (kind == 11)) != 0
        ch = (ch + (kind == 14) + (kind == 15)) != 0
        temp = byte_load(10160 + index) + byte_load(10200 + index) * 256
        got = start - temp - 4
        value = got / 256
        byte_store(temp * ch + 12200 * (ch == 0), got - value * 256)
        got = value
        value = got / 256
        byte_store((temp + 1) * ch + 12200 * (ch == 0), got - value * 256)
        got = value
        value = got / 256
        byte_store((temp + 2) * ch + 12200 * (ch == 0), got - value * 256)
        got = value
        value = got / 256
        byte_store((temp + 3) * ch + 12200 * (ch == 0), got - value * 256)
        index = index + 1
        active = ok * byte_load(13096) * byte_load(13113) * (index < status)
    }

    # Patch every literal LEA to its range in the single RX payload appended
    # after code and diagnostics. Dynamic memory output keeps its fixed RW
    # address and does not participate in this pass.
    index = 0
    active = ok * byte_load(13096) * (index < status)
    while active {
        kind = byte_load(10000 + index)
        state = kind == 7
        ch = byte_load(10040 + index) + byte_load(10120 + index) * 256
        temp = byte_load(10240 + index) + byte_load(10280 + index) * 256
        got = out + ch - temp - 4
        value = got / 256
        byte_store(temp * state + 12200 * (state == 0), got - value * 256)
        got = value
        value = got / 256
        byte_store((temp + 1) * state + 12200 * (state == 0), got - value * 256)
        got = value
        value = got / 256
        byte_store((temp + 2) * state + 12200 * (state == 0), got - value * 256)
        got = value
        value = got / 256
        byte_store((temp + 3) * state + 12200 * (state == 0), got - value * 256)
        index = index + 1
        active = ok * byte_load(13096) * (index < status)
    }

    index = 0
    got = byte_load(13083) + byte_load(13107) * 256
    while (index < got) * ok * byte_load(13096) {
        byte_store(out + index, byte_load(20000 + index))
        index = index + 1
    }
    out = out + got * ok * byte_load(13096)

    active = ok * byte_load(13096)
    while active {
        got = out - 4096
        value = got / 256
        byte_store(4192, got - value * 256)
        byte_store(4193, value)
        byte_store(4200, got - value * 256)
        byte_store(4201, value)
        output_write(4096, got)
        active = 0
    }

    # Convert the first failing byte offset to a one-based location.
    status = ok == 0
    pos = 0
    value = 1
    temp = 1
    while (pos < error) * status {
        ch = byte_load(pos)
        index = ch == 10
        value = value + index
        temp = (temp + 1) * (index == 0) + index
        pos = pos + 1
    }

    active = status
    while active {
        byte_store(8192, 105)
        byte_store(8193, 110)
        byte_store(8194, 112)
        byte_store(8195, 117)
        byte_store(8196, 116)
        byte_store(8197, 58)
        out = 8198

        state = value
        index = 0
        ch = state / 1000
        got = ch != 0
        byte_store(out * got + 12020 * (got == 0), ch + 48)
        out = out + got
        index = index + got
        state = state - ch * 1000
        ch = state / 100
        got = ((ch != 0) + index) != 0
        byte_store(out * got + 12020 * (got == 0), ch + 48)
        out = out + got
        index = index + got
        state = state - ch * 100
        ch = state / 10
        got = ((ch != 0) + index) != 0
        byte_store(out * got + 12020 * (got == 0), ch + 48)
        out = out + got
        state = state - ch * 10
        byte_store(out, state + 48)
        out = out + 1
        byte_store(out, 58)
        out = out + 1

        state = temp
        index = 0
        ch = state / 1000
        got = ch != 0
        byte_store(out * got + 12020 * (got == 0), ch + 48)
        out = out + got
        index = index + got
        state = state - ch * 1000
        ch = state / 100
        got = ((ch != 0) + index) != 0
        byte_store(out * got + 12020 * (got == 0), ch + 48)
        out = out + got
        index = index + got
        state = state - ch * 100
        ch = state / 10
        got = ((ch != 0) + index) != 0
        byte_store(out * got + 12020 * (got == 0), ch + 48)
        out = out + got
        state = state - ch * 10
        byte_store(out, state + 48)
        out = out + 1

        byte_store(out, 58)
        out = out + 1
        byte_store(out, 32)
        out = out + 1
        byte_store(out, 101)
        out = out + 1
        byte_store(out, 114)
        out = out + 1
        byte_store(out, 114)
        out = out + 1
        byte_store(out, 111)
        out = out + 1
        byte_store(out, 114)
        out = out + 1
        byte_store(out, 91)
        out = out + 1
        byte_store(out, 67)
        out = out + 1
        byte_store(out, 48)
        out = out + 1
        byte_store(out, 45)
        out = out + 1
        byte_store(out, 48)
        out = out + 1
        byte_store(out, 48)
        out = out + 1
        byte_store(out, 49)
        out = out + 1
        byte_store(out, 93)
        out = out + 1
        byte_store(out, 58)
        out = out + 1
        byte_store(out, 32)
        out = out + 1
        byte_store(out, 105)
        out = out + 1
        byte_store(out, 110)
        out = out + 1
        byte_store(out, 118)
        out = out + 1
        byte_store(out, 97)
        out = out + 1
        byte_store(out, 108)
        out = out + 1
        byte_store(out, 105)
        out = out + 1
        byte_store(out, 100)
        out = out + 1
        byte_store(out, 32)
        out = out + 1
        byte_store(out, 67)
        out = out + 1
        byte_store(out, 48)
        out = out + 1
        byte_store(out, 32)
        out = out + 1
        byte_store(out, 112)
        out = out + 1
        byte_store(out, 114)
        out = out + 1
        byte_store(out, 111)
        out = out + 1
        byte_store(out, 103)
        out = out + 1
        byte_store(out, 114)
        out = out + 1
        byte_store(out, 97)
        out = out + 1
        byte_store(out, 109)
        out = out + 1
        byte_store(out, 10)
        out = out + 1
        error_write(8192, out - 8192)
        active = 0
    }

    return status
}
