fn main() {
    input_read(0, 49)

    byte_assert_range(0, 1, 16)
    byte_store(64, byte_load(0))
    byte_store(65, 1)

    byte_load_at(65, 66)
    byte_assert_range(66, 4, 5)
    byte_store(65, byte_load(65) - 255)
    byte_load_at(65, 67)
    byte_assert_range(67, 0, 15)
    byte_store(65, byte_load(65) - 255)
    byte_load_at(65, 68)
    byte_assert_range(68, 1, 16)
    byte_store(65, byte_load(65) - 255)
    byte_store(64, byte_load(64) - 1)

    while byte_load(64) {
        byte_load_at(65, 66)
        byte_assert_range(66, 15, 18)
        byte_store(65, byte_load(65) - 255)
        byte_load_at(65, 67)
        byte_assert_range(67, 0, 15)
        byte_store(65, byte_load(65) - 255)
        byte_load_at(65, 68)
        byte_assert_range(68, 1, 16)
        byte_store(65, byte_load(65) - 255)
        byte_store(64, byte_load(64) - 1)
        byte_assert_range(64, 1, 16)

        byte_load_at(65, 66)
        byte_assert_range(66, 4, 5)
        byte_store(65, byte_load(65) - 255)
        byte_load_at(65, 67)
        byte_assert_range(67, 0, 15)
        byte_store(65, byte_load(65) - 255)
        byte_load_at(65, 68)
        byte_assert_range(68, 1, 16)
        byte_store(65, byte_load(65) - 255)
        byte_store(64, byte_load(64) - 1)
    }

    output_write(0, 49)
    write("\x01\x01\0")
    output_write(0, 1)
    return 0
}
