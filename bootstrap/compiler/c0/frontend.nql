# C0.32 source-to-AST frontend, compiled by B0 --compiler-profile.
# Legacy NQAF/1..5 is unchanged; native scopes/operations use NQAF/6 dialect5.
# Flat state transitions are intentional: B0 has no nested statement blocks.
fn main() {
    let got = input_read(1180288, 16)
    let count = got
    let pos = 0
    let ch = 0
    let tokens = 0
    let kind = 0
    let start = 0
    let state = 0
    let ok = 1
    let error = 0
    let temp = 0
    let index = 0
    let active = 1
    let nodes = 0
    let values = 0
    let operators = 0

    # Prefix bytes live in transport scratch, never in source lookahead.
    while got * (count < 16) {
        got = input_read(1180288 + count, 16 - count)
        count = count + got
    }
    active = (4 <= count) * (byte_load(1180288) == 78) * (byte_load(1180289) == 81)
    active = active * (byte_load(1180290) == 83) * (byte_load(1180291) == 67)
    byte_store(1180164, active)
    ok = (active == 0) + active * (count == 16) * (byte_load(1180292) == 1) * (byte_load(1180293) == 1)
    pos = 6
    while active * ok * (pos < 16) {
        ok = byte_load(1180288 + pos) == 0
        pos = pos + 1
    }
    byte_store(1180163, 13)
    pos = 0
    while pos < count * (active == 0) {
        byte_store(pos, byte_load(1180288 + pos))
        pos = pos + 1
    }
    count = count * (active == 0)
    got = 1
    while got * ok * (count < 262145) {
        got = input_read(count, 262145 - count)
        count = count + got
    }
    temp = ok * (count == 262145)
    error = 262144 * temp
    byte_store(1180163, 2 * temp + byte_load(1180163) * (temp == 0))
    ok = ok * (count < 262145)
    pos = 0
    active = 1

    # Tokens at 327680: kind/reserved u32, offset u32, length u32; stride 12.
    # EOF has kind/length zero. Source has at least six zero lookahead bytes.
    # Lexer states: start=0, identifier=1, decimal=2, line comment=3.
    while active * ok {
        ch = byte_load(pos)
        byte_store(1180200, state == 0)
        byte_store(1180201, state == 1)
        byte_store(1180202, state == 2)
        byte_store(1180203, (ch == 32) + (ch == 9) + (ch == 10) + (ch == 13))
        temp = (65 <= ch) * (ch <= 90) + (97 <= ch) * (ch <= 122) + (ch == 95)
        byte_store(1180204, temp)
        byte_store(1180205, (48 <= ch) * (ch <= 57))
        byte_store(1180206, (temp + byte_load(1180205)) != 0)
        byte_store(1180207, pos == count)
        byte_store(1180208, byte_load(1180201) * (byte_load(1180206) == 0))
        byte_store(1180209, byte_load(1180202) * (byte_load(1180205) == 0))
        temp = (ch == 35) + (ch == 47) * (byte_load(pos + 1) == 47)
        byte_store(1180211, byte_load(1180200) * (temp != 0) * (pos < count))

        kind = 10 * (ch == 40) + 11 * (ch == 41)
        kind = kind + 12 * (ch == 123) + 13 * (ch == 125) + 14 * (ch == 59)
        kind = kind + 15 * (ch == 43) + 16 * (ch == 42) + 17 * (ch == 45)
        kind = kind + 18 * (ch == 47) + 19 * (ch == 61)
        temp = byte_load(pos + 1) == 61
        kind = kind + (20 + temp) * (ch == 60) + (22 + temp) * (ch == 62)
        kind = kind + 5 * (ch == 61) * temp + 25 * (ch == 33) * temp
        kind = kind + 26 * (ch == 44)
        kind = kind * byte_load(1180200) * (byte_load(1180211) == 0) * (pos < count)
        byte_store(1180210, kind != 0)
        byte_store(1180215, ((kind == 21) + (kind == 23) + (kind == 24) + (kind == 25)))
        byte_store(1180162, (byte_load(1180162) + (20 <= kind) * (kind <= 25)) != 0)

        # Keyword matching uses the entire lexeme. 'main' remains an identifier.
        temp = pos - start
        byte_store(1180212, (temp == 2) * (byte_load(start) == 102) * (byte_load(start + 1) == 110))
        index = (temp == 3) * (byte_load(start) == 108) * (byte_load(start + 1) == 101)
        byte_store(1180213, index * (byte_load(start + 2) == 116))
        index = (temp == 6) * (byte_load(start) == 114) * (byte_load(start + 1) == 101)
        index = index * (byte_load(start + 2) == 116) * (byte_load(start + 3) == 117)
        byte_store(1180214, index * (byte_load(start + 4) == 114) * (byte_load(start + 5) == 110))
        index = 4 - 3 * byte_load(1180212) - 2 * byte_load(1180213) - byte_load(1180214)
        temp = pos - start
        index = index + 2 * (temp == 2) * (byte_load(start) == 105) * (byte_load(start + 1) == 102)
        ch = (temp == 4) * (byte_load(start) == 101) * (byte_load(start + 1) == 108)
        index = index + 3 * ch * (byte_load(start + 2) == 115) * (byte_load(start + 3) == 101)
        ch = (temp == 5) * (byte_load(start) == 119) * (byte_load(start + 1) == 104)
        ch = ch * (byte_load(start + 2) == 105) * (byte_load(start + 3) == 108)
        index = index + 4 * ch * (byte_load(start + 4) == 101)
        kind = kind + index * byte_load(1180208) + 5 * byte_load(1180209)
        ch = byte_load(pos)

        error = pos
        byte_store(1180163, 1)
        temp = byte_load(1180203) + byte_load(1180204) + byte_load(1180205)
        temp = temp + byte_load(1180210) + byte_load(1180211) + byte_load(1180207)
        ok = ok * ((byte_load(1180200) == 0) + byte_load(1180200) * (temp != 0))
        ok = ok * ((byte_load(1180209) * byte_load(1180204)) == 0)
        ok = ok * ((ch != 13) + (ch == 13) * (byte_load(pos + 1) == 10))
        # Comments are text too: reject NUL/non-ASCII instead of hiding corruption.
        ok = ok * ((pos == count) + (pos < count) * (ch != 0) * (ch < 128))

        active = (kind != 0) * ok
        temp = byte_load(1180208) + byte_load(1180209)
        index = start * temp + pos * (temp == 0)
        error = index * active + error * (active == 0)
        byte_store(1180163, 3 * active + byte_load(1180163) * (active == 0))
        ok = ok * ((active == 0) + active * (tokens < 65536))
        active = active * ok
        temp = (pos - start) * temp + byte_load(1180210) + byte_load(1180215)
        ch = 327680 + tokens * 12
        ch = ch * active + 8384512 * (active == 0)
        byte_store(ch, kind)
        byte_store(ch + 4, index)
        byte_store(ch + 5, index / 256)
        byte_store(ch + 6, index / 65536)
        byte_store(ch + 7, index / 16777216)
        byte_store(ch + 8, temp)
        byte_store(ch + 9, temp / 256)
        byte_store(ch + 10, temp / 65536)
        byte_store(ch + 11, temp / 16777216)
        tokens = tokens + active

        ch = byte_load(pos)
        temp = byte_load(1180200) * (byte_load(1180204) + byte_load(1180205)) * (pos < count)
        start = pos * temp + start * (temp == 0)
        temp = byte_load(1180200) * byte_load(1180204) + byte_load(1180201) * byte_load(1180206)
        temp = temp + 2 * (byte_load(1180200) * byte_load(1180205) + byte_load(1180202) * byte_load(1180205))
        temp = temp + 3 * (byte_load(1180211) + (state == 3) * (ch != 10) * (pos < count))
        index = byte_load(1180200) * (byte_load(1180203) + byte_load(1180204) + byte_load(1180205) + byte_load(1180210) + byte_load(1180211))
        index = index + byte_load(1180201) * byte_load(1180206) + byte_load(1180202) * byte_load(1180205)
        index = index + (state == 3) * (pos < count)
        active = ((pos == count) * ((state == 0) + (state == 3))) == 0
        pos = pos + ((index != 0) + byte_load(1180215)) * (pos < count)
        state = temp
    }

    byte_store(327684 + tokens * 12, count)
    byte_store(327685 + tokens * 12, count / 256)
    byte_store(327686 + tokens * 12, count / 65536)
    byte_store(327687 + tokens * 12, count / 16777216)

    # Select the function format before allocating records; old programs retain
    # byte-identical NQAF/1 and /2. A call is an identifier followed by '(' not fn.
    pos = 0
    state = 0
    operators = 0
    while ok * (pos < tokens) {
        kind = byte_load(327680 + pos * 12)
        # Until a control body's brace, even the final unsafe in a compound
        # condition is an operand. Reuse the still-idle operator local as a bit.
        operators = ((operators + (kind == 6) + (kind == 8)) != 0) * (kind != 12)
        state = state + (kind == 1)
        start = byte_load(327684 + pos * 12) + 256 * byte_load(327685 + pos * 12) + 65536 * byte_load(327684 + pos * 12 + 2) + 16777216 * byte_load(327684 + pos * 12 + 3)
        ch = byte_load(327688 + pos * 12) + 256 * byte_load(327689 + pos * 12) + 65536 * byte_load(327688 + pos * 12 + 2) + 16777216 * byte_load(327688 + pos * 12 + 3)
        temp = (ch == 4) * (byte_load(start) == 109) * (byte_load(start + 1) == 97)
        temp = temp * (byte_load(start + 2) == 105) * (byte_load(start + 3) == 110)
        index = byte_load(327680 + (pos - (pos != 0)) * 12) == 1
        active = (kind == 4) * (byte_load(327680 + (pos + 1) * 12) == 10)
        active = active * ((index == 0) + index * (temp == 0))
        temp = (kind == 4) * index * (pos + 2 <= tokens)
        index = pos + 2 * (pos + 2 <= tokens)
        active = active + temp * (byte_load(327680 + index * 12) != 11) + (1 < state)
        # Contextual scopes require function envelopes even without any call.
        # No lexer keyword is reserved: ordinary unsafe identifiers retain bytes.
        temp = (kind == 4) * (ch == 6) * (byte_load(327680 + (pos + 1) * 12) == 12) * (operators == 0)
        temp = temp * (byte_load(start) == 117) * (byte_load(start + 1) == 110) * (byte_load(start + 2) == 115)
        temp = temp * (byte_load(start + 3) == 97) * (byte_load(start + 4) == 102) * (byte_load(start + 5) == 101)
        active = active + temp
        byte_store(1180161, (byte_load(1180161) + active) != 0)
        pos = pos + 1
    }
    operators = 0
    byte_store(1180032, 1)
    byte_store(1180033, 4)
    byte_store(1180034, 10)
    byte_store(1180035, 11)
    byte_store(1180036, 12)
    pos = 0
    state = 0

    # Parser states: fn/main/(/)/{ = 0..4, statement=5, binding=6, '='=7,
    # expression=8, return separator=10, closing brace=11, EOF=12, done=13,
    # else keyword=14, else brace=15; parameter separator=16, required param=17,
    # call close=18. 1179680 holds block depth; 6488064 is its 16-byte sentinel.
    # Operators at 4194304, stride 12: token u32, reserved u32, kind/precedence.
    # Operand IDs at 5046272, stride 4. Call markers at 5373952, stride 16:
    # value base u32, last argument ID u32, arity u8, then reserved zero.
    # 1180160 selects NQAF/4; action 17 starts a call statement without consuming.
    # State: 1179648/1179652 first/last statement u32; 1179656 statement kind;
    # 1179660: binding id; 1179664/1179672: anchor offset/length; 1179668: want operand.
    # Scratch 1180200: action, 1180201: consume, 1180202: state snapshot.
    # Native metadata uses previously free [0x660000,0x6a0000): one u32
    # header-start offset per node, written only for a bounded kind45 allocation.
    # [0x6a0000,0x6b0000) holds one exact native-name class byte per node.
    # Both end before inactive stores at 0x7ff000 and inside the 16 MiB arena.
    # Scratch [1180240,1180264) is free within [0x120000,0x130000).
    # Action18 opens unsafe directly into statement state5; action9 closes it.
    while ok * (state != 13) {
        kind = byte_load(327680 + pos * 12)
        start = byte_load(327684 + pos * 12) + 256 * byte_load(327685 + pos * 12) + 65536 * byte_load(327684 + pos * 12 + 2) + 16777216 * byte_load(327684 + pos * 12 + 3)
        ch = byte_load(327688 + pos * 12) + 256 * byte_load(327689 + pos * 12) + 65536 * byte_load(327688 + pos * 12 + 2) + 16777216 * byte_load(327688 + pos * 12 + 3)
        error = start
        byte_store(1180163, 4)
        byte_store(1180200, 0)
        byte_store(1180201, 0)
        byte_store(1180202, state)
        temp = (kind == 4) * (ch == 6) * (byte_load(327680 + (pos + (pos < tokens)) * 12) == 12)
        temp = temp * (byte_load(start) == 117) * (byte_load(start + 1) == 110) * (byte_load(start + 2) == 115)
        temp = temp * (byte_load(start + 3) == 97) * (byte_load(start + 4) == 102) * (byte_load(start + 5) == 101)
        byte_store(1180240, temp)

        # Function envelope; a name prefix such as main_extra does not match.
        active = (state < 5) * (kind == byte_load(1180032 + state))
        temp = (ch == 4) * (byte_load(start) == 109) * (byte_load(start + 1) == 97)
        temp = temp * (byte_load(start + 2) == 105) * (byte_load(start + 3) == 110)
        active = active * ((state != 1) + (state == 1) * ((temp + byte_load(1180161)) != 0))
        index = 1179676 * (active * (state == 0) * (nodes == 0)) + 8384512 * ((active * (state == 0) * (nodes == 0)) == 0)
        byte_store(index, start)
        byte_store(index + 1, start / 256)
        byte_store(index + 2, start / 65536)
        byte_store(index + 3, start / 16777216)
        state = state + active
        byte_store(1180201, active)
        byte_store(1180200, 10 * active * (byte_load(1180202) == 1) * byte_load(1180161))
        temp = active * (byte_load(1180202) == 0)
        byte_store(1179681, byte_load(1179681) * (temp == 0))
        active = ((byte_load(1180202) == 3) + (byte_load(1180202) == 17)) * (kind == 4) * byte_load(1180161)
        byte_store(1180200, byte_load(1180200) + 11 * active)
        state = 16 * active + state * (active == 0)
        active = (byte_load(1180202) == 16) * ((kind == 26) + (kind == 11))
        state = active * (17 * (kind == 26) + 4 * (kind == 11)) + state * (active == 0)
        byte_store(1180201, byte_load(1180201) + active)

        # A call statement starts the existing expression parser without a binding.
        temp = (kind == 4) * (byte_load(327680 + (pos + (pos < tokens)) * 12) == 10)
        byte_store(1180222, temp)
        active = (byte_load(1180202) == 5) * ((kind == 2) + (kind == 3) + (kind == 4) + (kind == 6) + (kind == 8)) * (byte_load(1180240) == 0)
        index = 1179656 * active + 8384512 * (active == 0)
        byte_store(index, 30 * (kind == 2) + 31 * (kind == 4) + 32 * (kind == 3) + 34 * (kind == 8) + 36 * (kind == 6) + 13 * temp)
        index = 1179664 * active + 8384512 * (active == 0)
        byte_store(index, start)
        byte_store(index + 1, start / 256)
        byte_store(index + 2, start / 65536)
        byte_store(index + 3, start / 16777216)
        index = 1179672 * active + 8384512 * (active == 0)
        byte_store(index, ch)
        byte_store(index + 1, ch / 256)
        byte_store(index + 2, ch / 65536)
        byte_store(index + 3, ch / 16777216)
        byte_store(1179668, active + byte_load(1179668) * (active == 0))
        state = state * (active == 0) + active * (6 * (kind == 2) + 7 * (kind == 4) + 8 * ((kind == 3) + (kind == 6) + (kind == 8)) + temp)
        byte_store(1180200, byte_load(1180200) + active * (8 * (kind == 4) + 9 * temp))
        byte_store(1180201, byte_load(1180201) + active * (kind != 4))
        byte_store(1180160, (byte_load(1180160) + active * temp) != 0)
        active = (byte_load(1180202) == 5) * byte_load(1180240)
        byte_store(1180200, byte_load(1180200) + 18 * active)

        # A binding name creates its own leaf; semantic resolution is not done here.
        active = (byte_load(1180202) == 6) * (kind == 4)
        byte_store(1180200, byte_load(1180200) + 8 * active)
        state = 7 * active + state * (active == 0)
        active = (byte_load(1180202) == 7) * (kind == 19)
        byte_store(1180201, byte_load(1180201) + active)
        state = 8 * active + state * (active == 0)

        # Shunting-yard transitions. Stack zero is a sentinel, not an operand.
        active = byte_load(1180202) == 8
        byte_store(1180203, active * byte_load(1179668))
        byte_store(1180204, active * (byte_load(1179668) == 0))
        byte_store(1180205, (kind == 15) + (kind == 16) + (kind == 17) + (kind == 18) + (20 <= kind) * (kind <= 25))
        byte_store(1180206, byte_load(4194312 + operators * 12))
        temp = 3 * ((kind == 15) + (kind == 17)) + 4 * ((kind == 16) + (kind == 18))
        temp = temp + 2 * (20 <= kind) * (kind <= 23) + (kind == 24) + (kind == 25)
        byte_store(1180207, temp)
        index = (kind == 2) + (kind == 3) + (kind == 6) + (kind == 8) + (kind == 13) + (kind == 14) + (kind == 0)
        index = index + (kind == 4) * (byte_load(327680 + (pos + (pos < tokens)) * 12) == 19) + byte_load(1180222) + byte_load(1180240)
        temp = (byte_load(1179656) == 34) + (byte_load(1179656) == 36)
        index = index * (temp == 0) + (kind == 12) * temp
        byte_store(1180208, index != 0)

        index = (kind == 4) * (byte_load(327680 + (pos + (pos < tokens)) * 12) == 10)
        byte_store(1180221, index)
        temp = byte_load(1180203) * ((kind == 4) * (index == 0) + (kind == 5))
        temp = temp + 2 * byte_load(1180203) * (kind == 10)
        temp = temp + 14 * byte_load(1180203) * index
        byte_store(1180200, byte_load(1180200) + temp)

        # Reduce left-associatively while the top precedence is at least incoming.
        temp = byte_load(1180204) * byte_load(1180205)
        index = (operators != 0) * (byte_load(1180206) != 10) * (byte_load(1180206) != 42)
        index = index * (byte_load(1180207) <= byte_load(4194313 + operators * 12))
        byte_store(1180200, byte_load(1180200) + temp * (3 * (index == 0) + 5 * index))
        temp = byte_load(1180204) * (kind == 11) * (operators != 0)
        index = byte_load(1180206) == 10
        byte_store(1180200, byte_load(1180200) + temp * (4 * index + 15 * (byte_load(1180206) == 42) + 5 * (index == 0) * (byte_load(1180206) != 42)))
        temp = byte_load(1180204) * (kind == 26) * (operators != 0) * (byte_load(1180206) != 10)
        byte_store(1180200, byte_load(1180200) + temp * (15 * (byte_load(1180206) == 42) + 5 * (byte_load(1180206) != 42)))
        temp = byte_load(1180203) * (kind == 11) * (operators != 0) * (byte_load(1180206) == 42)
        temp = temp * (byte_load(5373960 + operators * 16) == 0)
        temp = temp + (byte_load(1180202) == 18) * (kind == 11)
        byte_store(1180200, byte_load(1180200) + 16 * temp)
        temp = byte_load(1180204) * byte_load(1180208)
        index = (operators != 0) * (byte_load(1180206) != 10) * (byte_load(1180206) != 42)
        byte_store(1180200, byte_load(1180200) + temp * (5 * index + 6 * (operators == 0)))

        # Delimiters are structured statement records, not arbitrary jump targets.
        # Closing an if then-arm looks ahead once for its optional else block.
        active = ((byte_load(1180202) == 5) + (byte_load(1180202) == 10) + (byte_load(1180202) == 11))
        active = active * (kind == 13) * (byte_load(1179680) != 0)
        temp = byte_load(6488064 + byte_load(1179680) * 16)
        index = (temp == 36) * (byte_load(327680 + (pos + (pos < tokens)) * 12) == 7)
        byte_store(1180216, 35 * (temp == 34) + 38 * ((temp == 36) + (temp == 37)) + 46 * (temp == 45) - index)
        byte_store(1180200, byte_load(1180200) + 9 * active)
        active = (byte_load(1180202) == 14) * (kind == 7)
        state = 15 * active + state * (active == 0)
        byte_store(1180201, byte_load(1180201) + active)
        active = (byte_load(1180202) == 15) * (kind == 12)
        state = 5 * active + state * (active == 0)
        byte_store(1180201, byte_load(1180201) + active)

        # After top-level return, allow one semicolon, then exactly '}' and EOF.
        active = (byte_load(1180202) == 10) * (kind == 14)
        state = 11 * active + state * (active == 0)
        byte_store(1180201, byte_load(1180201) + active)
        active = ((byte_load(1180202) == 10) + (byte_load(1180202) == 11)) * (kind == 13) * (byte_load(1179680) == 0)
        state = 12 * active + state * (active == 0)
        byte_store(1180201, byte_load(1180201) + active)
        byte_store(1180200, byte_load(1180200) + 12 * active * byte_load(1180161))
        active = (byte_load(1180202) == 12) * (kind == 0)
        byte_store(1180200, byte_load(1180200) + 7 * active)
        active = (byte_load(1180202) == 12) * (kind == 1) * byte_load(1180161)
        byte_store(1180200, byte_load(1180200) + 13 * active)
        state = state * (active == 0)

        # Classify a rejected transition before any externally visible output.
        temp = byte_load(1180202)
        index = 4 * ((temp < 6) + (temp == 9))
        index = index + 8 * ((temp == 6) + (temp == 7))
        index = index + 6 * byte_load(1180203) + 7 * byte_load(1180204)
        index = index + 9 * ((temp == 10) + (temp == 11)) + 10 * (temp == 12) + 4 * (14 <= temp)
        byte_store(1180163, index)
        ok = ok * ((byte_load(1180201) + byte_load(1180200)) != 0)
        ok = ok * ((byte_load(1180200) != 5) + (byte_load(1180200) == 5) * (2 <= values))
        ok = ok * ((byte_load(1180200) != 6) + (byte_load(1180200) == 6) * (values == 1))
        # Discard only calls, never silently accept a discarded arithmetic tree.
        temp = (byte_load(1180200) == 6) * (byte_load(1179656) == 44)
        index = byte_load(5046272 + values * 4) + 256 * byte_load(5046273 + values * 4) + 65536 * byte_load(5046272 + values * 4 + 2) + 16777216 * byte_load(5046272 + values * 4 + 3)
        byte_store(1180163, 7 * temp + byte_load(1180163) * (temp == 0))
        index = (2097152 + (index - 1) * 32) * (index != 0) + 8384512 * (index == 0)
        ok = ok * ((temp == 0) + temp * (byte_load(index) == 42))
        temp = byte_load(1180200)
        index = byte_load(5373952 + operators * 16) + 256 * byte_load(5373953 + operators * 16) + 65536 * byte_load(5373952 + operators * 16 + 2) + 16777216 * byte_load(5373952 + operators * 16 + 3)
        ch = (temp == 15) * (6 <= byte_load(5373960 + operators * 16)) + (temp == 11) * (6 <= byte_load(1179681))
        byte_store(1180163, 12 * ch + byte_load(1180163) * (ch == 0))
        ok = ok * ((temp != 15) + (temp == 15) * (values == index + 1) * (byte_load(5373960 + operators * 16) < 6))
