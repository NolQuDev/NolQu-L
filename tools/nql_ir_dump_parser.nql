var output_path = ""
var output_to_file = 0

func emit_line(line str) {
    if output_to_file == 1 {
        var n = append_file(output_path, line + "\n")
        return n
    } else {
        print line
    }
    return 0
}


func next_line_end(text str, pos int, total int) {
    var i = pos
    while i < total {
        if slice(text, i, i + 1) == "\n" {
            return i
        }
        i = i + 1
    }
    return total
}

func json_escape(value str) {
    var out = ""
    var i = 0
    var total = len(value)
    while i < total {
        var ch = slice(value, i, i + 1)
        if ch == "\"" {
            out = out + "\\\""
        } else {
            if ch == "\\" {
                out = out + "\\\\"
            } else {
                if ch == "\t" {
                    out = out + "\\t"
                } else {
                    out = out + ch
                }
            }
        }
        i = i + 1
    }
    return out
}

func emit_item(line str, first) {
    if first == 0 {
        emit_line("  },")
    }
    var tab = find(line, "\t")
    var a_pos = find(line, " A=")
    var b_pos = find(line, " B=")
    var ln_pos = find(line, " LN=")
    var name_pos = find(line, " NAME=")
    var text_pos = find(line, " TEXT=")
    if tab < 0 {
        print "nq_ir_dump_parser: malformed IR line"
        exit(1)
    }
    if a_pos < 0 {
        print "nq_ir_dump_parser: malformed IR line"
        exit(1)
    }
    if b_pos < 0 {
        print "nq_ir_dump_parser: malformed IR line"
        exit(1)
    }
    if ln_pos < 0 {
        print "nq_ir_dump_parser: malformed IR line"
        exit(1)
    }
    var line_end = len(line)
    if name_pos >= 0 {
        line_end = name_pos
    }
    if text_pos >= 0 {
        if name_pos < 0 {
            line_end = text_pos
        }
    }
    var item_index = int(slice(line, 0, tab))
    var op = slice(line, tab + 1, a_pos)
    var a = int(slice(line, a_pos + 3, b_pos))
    var b = int(slice(line, b_pos + 3, ln_pos))
    var source_line = int(slice(line, ln_pos + 4, line_end))
    emit_line("  {")
    emit_line("    \"index\": " + str(item_index) + ",")
    emit_line("    \"op\": \"" + op + "\",")
    emit_line("    \"a\": " + str(a) + ",")
    emit_line("    \"b\": " + str(b) + ",")
    if name_pos >= 0 {
        emit_line("    \"line\": " + str(source_line) + ",")
        var name_end = len(line)
        if text_pos >= 0 {
            name_end = text_pos
        }
        var name = json_escape(slice(line, name_pos + 6, name_end))
        if text_pos >= 0 {
            emit_line("    \"name\": \"" + name + "\",")
        } else {
            emit_line("    \"name\": \"" + name + "\"")
        }
    } else {
        if text_pos >= 0 {
            emit_line("    \"line\": " + str(source_line) + ",")
        } else {
            emit_line("    \"line\": " + str(source_line))
        }
    }
    if text_pos >= 0 {
        var text = json_escape(slice(line, text_pos + 6, len(line)))
        emit_line("    \"text\": \"" + text + "\"")
    }
    return 0
}

func emit_json(text str) {
    var total = len(text)
    var first_nl = find(text, "\n")
    if first_nl < 0 {
        first_nl = total
    }
    var header = slice(text, 0, first_nl)
    if header != "== IR ==" {
        print "nq_ir_dump_parser: missing IR header"
        exit(1)
    }
    emit_line("[")
    if header == "== IR ==" {
        var pos = first_nl + 1
        var first = 1
        while pos < total {
            var line_end = next_line_end(text, pos, total)
            var line = slice(text, pos, line_end)
            if len(line) > 0 {
                var ok = emit_item(line, first)
                if ok < 0 {
                    return -1
                }
                first = 0
            }
            pos = line_end + 1
        }
        if first == 0 {
            emit_line("  }")
        }
    }
    emit_line("]")
    return 0
}

if argc < 1 {
    print "usage: nq_ir_dump_parser.nq input.ir [output.json]"
    exit(1)
} else {
    var input_path = arg_str(0)
    if argc > 1 {
        output_path = arg_str(1)
        output_to_file = 1
        var clear = write_file(output_path, "")
        if clear < 0 {
            exit(1)
        }
    }
    var input_text = read_file(input_path)
    var status = emit_json(input_text)
    if status < 0 {
        exit(1)
    }
    if output_to_file == 1 {
        print "OK: " + output_path + " written"
    }
}
