# Streaming sum modulo 251. The runtime arena is 64 KiB by default;
# each read uses its first 256 bytes. No heap or opened file descriptors.

fn update_checksum(current, value) {
    let next = current + value
    return next - (next / 251) * 251
}

fn write_checksum(value) {
    byte_store(0, 48 + value / 100)
    byte_store(1, 48 + (value / 10) - (value / 100) * 10)
    byte_store(2, 48 + value - (value / 10) * 10)
    byte_store(3, 10)
    let start = 0
    if value < 100 {
        start = 1
        if value < 10 {
            start = 2
        }
    }
    return output_write(start, 4 - start)
}

fn main() {
    let checksum = 0
    let count = 1
    while count != 0 {
        count = input_read(0, 256)
        let index = 0
        while index < count {
            checksum = update_checksum(checksum, byte_load(index))
            index = index + 1
        }
    }
    write_checksum(checksum)
    return 0
}
