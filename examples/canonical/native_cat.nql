# Experimental standalone native Linux/x86_64 file reader.
# Frame [0,48), error text [64,86), NUL path [128,4224), data [8192,40960).
# Raw I/O retries and descriptor ownership are explicit; no host implementation.

fn put_word(offset, value) {
    let i = 0
    while i < 8 {
        byte_store(offset + i, value)
        let q = value / 256
        # Correct floor division retains two's-complement high bytes for negatives.
        if value - q * 256 < 0 { q = q - 1 }
        value = q
        i = i + 1
    }
    return 0
}

fn system(number, a, b, c, d) {
    put_word(0, a)
    put_word(8, b)
    put_word(16, c)
    put_word(24, d)
    put_word(32, 0)
    put_word(40, 0)
    let result = 0
    unsafe {
        # safety: this program owns the complete 48-byte frame; callers provide
        # the documented descriptor and checked arena spans for each Linux call.
        result = syscall6(number, 0)
    }
    return result
}

fn copy_input(fd) {
    let buffer = 0
    unsafe {
        # safety: [8192,40960) is inside both explicit bounded arena profiles.
        # Only synchronous read/write uses this address while the arena is alive.
        buffer = byte_address(8192, 32768)
    }
    let status = 0
    let reading = 1
    while reading {
        let n = system(0, fd, buffer, 32768, 0)
        if n == (0 - 4) {
            # EINTR before progress: retry this same read explicitly.
        } else {
            if (n < 0) + (32768 < n) {
                status = 1
                reading = 0
            } else {
                if n == 0 {
                    reading = 0
                } else {
                    let done = 0
                    while (done < n) * (status == 0) {
                        let written = system(1, 1, buffer + done, n - done, 0)
                        if written == (0 - 4) {
                            # No progress reported; keep pointer and remaining count.
                        } else {
                            if (written <= 0) + ((n - done) < written) {
                                status = 1
                            } else {
                                done = done + written
                            }
                        }
                    }
                    if status != 0 { reading = 0 }
                }
            }
        }
    }
    return status
}

fn main() {
    byte_store(64, 110)
    byte_store(65, 97)
    byte_store(66, 116)
    byte_store(67, 105)
    byte_store(68, 118)
    byte_store(69, 101)
    byte_store(70, 95)
    byte_store(71, 99)
    byte_store(72, 97)
    byte_store(73, 116)
    byte_store(74, 58)
    byte_store(75, 32)
    byte_store(76, 73)
    byte_store(77, 47)
    byte_store(78, 79)
    byte_store(79, 32)
    byte_store(80, 101)
    byte_store(81, 114)
    byte_store(82, 114)
    byte_store(83, 111)
    byte_store(84, 114)
    byte_store(85, 10)
    let count = arg_count()
    let i = 1
    let used = 0
    let status = 0
    while (i < count) * (status == 0) {
        let n = arg_copy(i, 128, 4096)
        let delimiter = (i == 1) * (n == 2) * (byte_load(128) == 45) * (byte_load(129) == 45)
        if delimiter == 0 {
            used = 1
            if (n == 1) * (byte_load(128) == 45) {
                status = copy_input(0)
            } else {
                let path = 0
                unsafe {
                    # safety: arg_copy validated n bytes plus NUL at [128,128+n+1).
                    # openat reads this path synchronously; no input file is written.
                    path = byte_address(128, n + 1)
                }
                # openat(AT_FDCWD,path,O_RDONLY,0), raw return retains -errno.
                let fd = system(257, 0 - 100, path, 0, 0)
                if fd < 0 {
                    status = 1
                } else {
                    status = copy_input(fd)
                    # This branch owns fd even when its numeric value is zero.
                    # Linux releases it on close, including late errors: never retry.
                    let closed = system(3, fd, 0, 0, 0)
                    if closed != 0 { status = 1 }
                }
            }
        }
        i = i + 1
    }
    if (used == 0) * (status == 0) { status = copy_input(0) }
    if status != 0 { error_write(64, 22) }
    return status
}
