# C0.30 source-to-AST frontend, compiled by B0. See RUNTIME_IO.md for NQAF/4.
# Flat state transitions are intentional: B0 has no nested statement blocks.
fn main() {
    let got = input_read(0, 8193)
    let count = got
    let pos = 0
    let ch = 0
    let tokens = 0
    let kind = 0
    let start = 0
    let state = 0
    let ok = 1
    let error = 0
    let temp = 0
    let index = 0
    let active = 1
    let nodes = 0
    let values = 0
    let operators = 0

    while got * (count < 8193) {
        got = input_read(count, 8193 - count)
        count = count + got
    }
    ok = count < 8193
    error = 8192 * (ok == 0)
    byte_store(14999, 2)

    # Token: kind, reserved, offset u16, length u16. EOF has kind/length zero.
    # Lexer states: start=0, identifier=1, decimal=2, line comment=3.
    while active * ok {
        ch = byte_load(pos)
        byte_store(15000, state == 0)
        byte_store(15001, state == 1)
        byte_store(15002, state == 2)
        byte_store(15003, (ch == 32) + (ch == 9) + (ch == 10) + (ch == 13))
        temp = (65 <= ch) * (ch <= 90) + (97 <= ch) * (ch <= 122) + (ch == 95)
        byte_store(15004, temp)
        byte_store(15005, (48 <= ch) * (ch <= 57))
        byte_store(15006, (temp + byte_load(15005)) != 0)
        byte_store(15007, pos == count)
        byte_store(15008, byte_load(15001) * (byte_load(15006) == 0))
        byte_store(15009, byte_load(15002) * (byte_load(15005) == 0))
        temp = (ch == 35) + (ch == 47) * (byte_load(pos + 1) == 47)
        byte_store(15011, byte_load(15000) * (temp != 0) * (pos < count))

        kind = 10 * (ch == 40) + 11 * (ch == 41)
        kind = kind + 12 * (ch == 123) + 13 * (ch == 125) + 14 * (ch == 59)
        kind = kind + 15 * (ch == 43) + 16 * (ch == 42) + 17 * (ch == 45)
        kind = kind + 18 * (ch == 47) + 19 * (ch == 61)
        temp = byte_load(pos + 1) == 61
        kind = kind + (20 + temp) * (ch == 60) + (22 + temp) * (ch == 62)
        kind = kind + 5 * (ch == 61) * temp + 25 * (ch == 33) * temp
        kind = kind + 26 * (ch == 44)
        kind = kind * byte_load(15000) * (byte_load(15011) == 0) * (pos < count)
        byte_store(15010, kind != 0)
        byte_store(15015, ((kind == 21) + (kind == 23) + (kind == 24) + (kind == 25)))
        byte_store(14998, (byte_load(14998) + (20 <= kind) * (kind <= 25)) != 0)

        # Keyword matching uses the entire lexeme. 'main' remains an identifier.
        temp = pos - start
        byte_store(15012, (temp == 2) * (byte_load(start) == 102) * (byte_load(start + 1) == 110))
        index = (temp == 3) * (byte_load(start) == 108) * (byte_load(start + 1) == 101)
        byte_store(15013, index * (byte_load(start + 2) == 116))
        index = (temp == 6) * (byte_load(start) == 114) * (byte_load(start + 1) == 101)
        index = index * (byte_load(start + 2) == 116) * (byte_load(start + 3) == 117)
        byte_store(15014, index * (byte_load(start + 4) == 114) * (byte_load(start + 5) == 110))
        index = 4 - 3 * byte_load(15012) - 2 * byte_load(15013) - byte_load(15014)
        temp = pos - start
        index = index + 2 * (temp == 2) * (byte_load(start) == 105) * (byte_load(start + 1) == 102)
        ch = (temp == 4) * (byte_load(start) == 101) * (byte_load(start + 1) == 108)
        index = index + 3 * ch * (byte_load(start + 2) == 115) * (byte_load(start + 3) == 101)
        ch = (temp == 5) * (byte_load(start) == 119) * (byte_load(start + 1) == 104)
        ch = ch * (byte_load(start + 2) == 105) * (byte_load(start + 3) == 108)
        index = index + 4 * ch * (byte_load(start + 4) == 101)
        kind = kind + index * byte_load(15008) + 5 * byte_load(15009)
        ch = byte_load(pos)

        error = pos
        byte_store(14999, 1)
        temp = byte_load(15003) + byte_load(15004) + byte_load(15005)
        temp = temp + byte_load(15010) + byte_load(15011) + byte_load(15007)
        ok = ok * ((byte_load(15000) == 0) + byte_load(15000) * (temp != 0))
        ok = ok * ((byte_load(15009) * byte_load(15004)) == 0)
        ok = ok * ((ch != 13) + (ch == 13) * (byte_load(pos + 1) == 10))
        # Comments are text too: reject NUL/non-ASCII instead of hiding corruption.
        ok = ok * ((pos == count) + (pos < count) * (ch != 0) * (ch < 128))

        active = (kind != 0) * ok
        temp = byte_load(15008) + byte_load(15009)
        index = start * temp + pos * (temp == 0)
        error = index * active + error * (active == 0)
        byte_store(14999, 3 * active + byte_load(14999) * (active == 0))
        ok = ok * ((active == 0) + active * (tokens < 512))
        active = active * ok
        temp = (pos - start) * temp + byte_load(15010) + byte_load(15015)
        ch = 10000 + tokens * 6
        ch = ch * active + 65000 * (active == 0)
        byte_store(ch, kind)
        byte_store(ch + 2, index)
        byte_store(ch + 3, index / 256)
        byte_store(ch + 4, temp)
        byte_store(ch + 5, temp / 256)
        tokens = tokens + active

        ch = byte_load(pos)
        temp = byte_load(15000) * (byte_load(15004) + byte_load(15005)) * (pos < count)
        start = pos * temp + start * (temp == 0)
        temp = byte_load(15000) * byte_load(15004) + byte_load(15001) * byte_load(15006)
        temp = temp + 2 * (byte_load(15000) * byte_load(15005) + byte_load(15002) * byte_load(15005))
        temp = temp + 3 * (byte_load(15011) + (state == 3) * (ch != 10) * (pos < count))
        index = byte_load(15000) * (byte_load(15003) + byte_load(15004) + byte_load(15005) + byte_load(15010) + byte_load(15011))
        index = index + byte_load(15001) * byte_load(15006) + byte_load(15002) * byte_load(15005)
        index = index + (state == 3) * (pos < count)
        active = ((pos == count) * ((state == 0) + (state == 3))) == 0
        pos = pos + ((index != 0) + byte_load(15015)) * (pos < count)
        state = temp
    }

    byte_store(10002 + tokens * 6, count)
    byte_store(10003 + tokens * 6, count / 256)

    # Select the function format before allocating records; old programs retain
    # byte-identical NQAF/1 and /2. A call is an identifier followed by '(' not fn.
    pos = 0
    state = 0
    while ok * (pos < tokens) {
        kind = byte_load(10000 + pos * 6)
        state = state + (kind == 1)
        start = byte_load(10002 + pos * 6) + 256 * byte_load(10003 + pos * 6)
        ch = byte_load(10004 + pos * 6) + 256 * byte_load(10005 + pos * 6)
        temp = (ch == 4) * (byte_load(start) == 109) * (byte_load(start + 1) == 97)
        temp = temp * (byte_load(start + 2) == 105) * (byte_load(start + 3) == 110)
        index = byte_load(10000 + (pos - (pos != 0)) * 6) == 1
        active = (kind == 4) * (byte_load(10000 + (pos + 1) * 6) == 10)
        active = active * ((index == 0) + index * (temp == 0))
        temp = (kind == 4) * index * (pos + 2 <= tokens)
        index = pos + 2 * (pos + 2 <= tokens)
        active = active + temp * (byte_load(10000 + index * 6) != 11) + (1 < state)
        byte_store(14997, (byte_load(14997) + active) != 0)
        pos = pos + 1
    }
    byte_store(14400, 1)
    byte_store(14401, 4)
    byte_store(14402, 10)
    byte_store(14403, 11)
    byte_store(14404, 12)
    pos = 0
    state = 0

    # Parser states: fn/main/(/)/{ = 0..4, statement=5, binding=6, '='=7,
    # expression=8, return separator=10, closing brace=11, EOF=12, done=13,
    # else keyword=14, else brace=15; parameter separator=16, required param=17,
    # call close=18. 14022 holds block depth; 35000 is its sentinel.
    # Call marker frames: 36000 + operator-index*6: value base, last arg, arity.
    # 14996 selects NQAF/4; action 17 starts a call statement without consuming.
    # State at 14000: first/last statement ids; 14004: statement kind;
    # 14006: binding id; 14008/14016: anchor offset/length; 14010: want operand.
    # Scratch 15000: action, 15001: consume, 15002: state snapshot.
    while ok * (state != 13) {
        kind = byte_load(10000 + pos * 6)
        start = byte_load(10002 + pos * 6) + 256 * byte_load(10003 + pos * 6)
        ch = byte_load(10004 + pos * 6) + 256 * byte_load(10005 + pos * 6)
        error = start
        byte_store(14999, 4)
        byte_store(15000, 0)
        byte_store(15001, 0)
        byte_store(15002, state)

        # Function envelope; a name prefix such as main_extra does not match.
        active = (state < 5) * (kind == byte_load(14400 + state))
        temp = (ch == 4) * (byte_load(start) == 109) * (byte_load(start + 1) == 97)
        temp = temp * (byte_load(start + 2) == 105) * (byte_load(start + 3) == 110)
        active = active * ((state != 1) + (state == 1) * ((temp + byte_load(14997)) != 0))
        index = 14020 * (active * (state == 0) * (nodes == 0)) + 65000 * ((active * (state == 0) * (nodes == 0)) == 0)
        byte_store(index, start)
        byte_store(index + 1, start / 256)
        state = state + active
        byte_store(15001, active)
        byte_store(15000, 10 * active * (byte_load(15002) == 1) * byte_load(14997))
        temp = active * (byte_load(15002) == 0)
        byte_store(14023, byte_load(14023) * (temp == 0))
        active = ((byte_load(15002) == 3) + (byte_load(15002) == 17)) * (kind == 4) * byte_load(14997)
        byte_store(15000, byte_load(15000) + 11 * active)
        state = 16 * active + state * (active == 0)
        active = (byte_load(15002) == 16) * ((kind == 26) + (kind == 11))
        state = active * (17 * (kind == 26) + 4 * (kind == 11)) + state * (active == 0)
        byte_store(15001, byte_load(15001) + active)

        # A call statement starts the existing expression parser without a binding.
        temp = (kind == 4) * (byte_load(10000 + (pos + (pos < tokens)) * 6) == 10)
        byte_store(15021, temp)
        active = (byte_load(15002) == 5) * ((kind == 2) + (kind == 3) + (kind == 4) + (kind == 6) + (kind == 8))
        index = 14004 * active + 65000 * (active == 0)
        byte_store(index, 30 * (kind == 2) + 31 * (kind == 4) + 32 * (kind == 3) + 34 * (kind == 8) + 36 * (kind == 6) + 13 * temp)
        index = 14008 * active + 65000 * (active == 0)
        byte_store(index, start)
        byte_store(index + 1, start / 256)
        index = 14016 * active + 65000 * (active == 0)
        byte_store(index, ch)
        byte_store(index + 1, ch / 256)
        byte_store(14010, active + byte_load(14010) * (active == 0))
        state = state * (active == 0) + active * (6 * (kind == 2) + 7 * (kind == 4) + 8 * ((kind == 3) + (kind == 6) + (kind == 8)) + temp)
        byte_store(15000, byte_load(15000) + active * (8 * (kind == 4) + 9 * temp))
        byte_store(15001, byte_load(15001) + active * (kind != 4))
        byte_store(14996, (byte_load(14996) + active * temp) != 0)

        # A binding name creates its own leaf; semantic resolution is not done here.
        active = (byte_load(15002) == 6) * (kind == 4)
        byte_store(15000, byte_load(15000) + 8 * active)
        state = 7 * active + state * (active == 0)
        active = (byte_load(15002) == 7) * (kind == 19)
        byte_store(15001, byte_load(15001) + active)
        state = 8 * active + state * (active == 0)

        # Shunting-yard transitions. Stack zero is a sentinel, not an operand.
        active = byte_load(15002) == 8
        byte_store(15003, active * byte_load(14010))
        byte_store(15004, active * (byte_load(14010) == 0))
        byte_store(15005, (kind == 15) + (kind == 16) + (kind == 17) + (kind == 18) + (20 <= kind) * (kind <= 25))
        byte_store(15006, byte_load(30002 + operators * 4))
        temp = 3 * ((kind == 15) + (kind == 17)) + 4 * ((kind == 16) + (kind == 18))
        temp = temp + 2 * (20 <= kind) * (kind <= 23) + (kind == 24) + (kind == 25)
        byte_store(15007, temp)
        index = (kind == 2) + (kind == 3) + (kind == 6) + (kind == 8) + (kind == 13) + (kind == 14) + (kind == 0)
        index = index + (kind == 4) * (byte_load(10000 + (pos + (pos < tokens)) * 6) == 19) + byte_load(15021)
        temp = (byte_load(14004) == 34) + (byte_load(14004) == 36)
        index = index * (temp == 0) + (kind == 12) * temp
        byte_store(15008, index != 0)

        index = (kind == 4) * (byte_load(10000 + (pos + (pos < tokens)) * 6) == 10)
        byte_store(15019, index)
        temp = byte_load(15003) * ((kind == 4) * (index == 0) + (kind == 5))
        temp = temp + 2 * byte_load(15003) * (kind == 10)
        temp = temp + 14 * byte_load(15003) * index
        byte_store(15000, byte_load(15000) + temp)

        # Reduce left-associatively while the top precedence is at least incoming.
        temp = byte_load(15004) * byte_load(15005)
        index = (operators != 0) * (byte_load(15006) != 10) * (byte_load(15006) != 42)
        index = index * (byte_load(15007) <= byte_load(30003 + operators * 4))
        byte_store(15000, byte_load(15000) + temp * (3 * (index == 0) + 5 * index))
        temp = byte_load(15004) * (kind == 11) * (operators != 0)
        index = byte_load(15006) == 10
        byte_store(15000, byte_load(15000) + temp * (4 * index + 15 * (byte_load(15006) == 42) + 5 * (index == 0) * (byte_load(15006) != 42)))
        temp = byte_load(15004) * (kind == 26) * (operators != 0) * (byte_load(15006) != 10)
        byte_store(15000, byte_load(15000) + temp * (15 * (byte_load(15006) == 42) + 5 * (byte_load(15006) != 42)))
        temp = byte_load(15003) * (kind == 11) * (operators != 0) * (byte_load(15006) == 42)
        temp = temp * (byte_load(36004 + operators * 6) == 0)
        temp = temp + (byte_load(15002) == 18) * (kind == 11)
        byte_store(15000, byte_load(15000) + 16 * temp)
        temp = byte_load(15004) * byte_load(15008)
        index = (operators != 0) * (byte_load(15006) != 10) * (byte_load(15006) != 42)
        byte_store(15000, byte_load(15000) + temp * (5 * index + 6 * (operators == 0)))

        # Delimiters are structured statement records, not arbitrary jump targets.
        # Closing an if then-arm looks ahead once for its optional else block.
        active = ((byte_load(15002) == 5) + (byte_load(15002) == 10) + (byte_load(15002) == 11))
        active = active * (kind == 13) * (byte_load(14022) != 0)
        temp = byte_load(35000 + byte_load(14022))
        index = (temp == 36) * (byte_load(10000 + (pos + (pos < tokens)) * 6) == 7)
        byte_store(15016, 35 * (temp == 34) + 38 * ((temp == 36) + (temp == 37)) - index)
        byte_store(15000, byte_load(15000) + 9 * active)
        active = (byte_load(15002) == 14) * (kind == 7)
        state = 15 * active + state * (active == 0)
        byte_store(15001, byte_load(15001) + active)
        active = (byte_load(15002) == 15) * (kind == 12)
        state = 5 * active + state * (active == 0)
        byte_store(15001, byte_load(15001) + active)

        # After top-level return, allow one semicolon, then exactly '}' and EOF.
        active = (byte_load(15002) == 10) * (kind == 14)
        state = 11 * active + state * (active == 0)
        byte_store(15001, byte_load(15001) + active)
        active = ((byte_load(15002) == 10) + (byte_load(15002) == 11)) * (kind == 13) * (byte_load(14022) == 0)
        state = 12 * active + state * (active == 0)
        byte_store(15001, byte_load(15001) + active)
        byte_store(15000, byte_load(15000) + 12 * active * byte_load(14997))
        active = (byte_load(15002) == 12) * (kind == 0)
        byte_store(15000, byte_load(15000) + 7 * active)
        active = (byte_load(15002) == 12) * (kind == 1) * byte_load(14997)
        byte_store(15000, byte_load(15000) + 13 * active)
        state = state * (active == 0)

        # Classify a rejected transition before any externally visible output.
        temp = byte_load(15002)
        index = 4 * ((temp < 6) + (temp == 9))
        index = index + 8 * ((temp == 6) + (temp == 7))
        index = index + 6 * byte_load(15003) + 7 * byte_load(15004)
        index = index + 9 * ((temp == 10) + (temp == 11)) + 10 * (temp == 12) + 4 * (14 <= temp)
        byte_store(14999, index)
        ok = ok * ((byte_load(15001) + byte_load(15000)) != 0)
        ok = ok * ((byte_load(15000) != 5) + (byte_load(15000) == 5) * (2 <= values))
        ok = ok * ((byte_load(15000) != 6) + (byte_load(15000) == 6) * (values == 1))
        # Discard only calls, never silently accept a discarded arithmetic tree.
        temp = (byte_load(15000) == 6) * (byte_load(14004) == 44)
        index = byte_load(33000 + values * 2) + 256 * byte_load(33001 + values * 2)
        byte_store(14999, 7 * temp + byte_load(14999) * (temp == 0))
        ok = ok * ((temp == 0) + temp * (byte_load(20000 + (index - 1) * 16) == 42))
        temp = byte_load(15000)
        index = byte_load(36000 + operators * 6) + 256 * byte_load(36001 + operators * 6)
        ch = (temp == 15) * (6 <= byte_load(36004 + operators * 6)) + (temp == 11) * (6 <= byte_load(14023))
        byte_store(14999, 12 * ch + byte_load(14999) * (ch == 0))
        ok = ok * ((temp != 15) + (temp == 15) * (values == index + 1) * (byte_load(36004 + operators * 6) < 6))
        ok = ok * ((temp != 16) + (temp == 16) * (values == index))
        ok = ok * ((temp != 11) + (temp == 11) * (byte_load(14023) < 6))
        temp = (byte_load(15000) == 6) * ((byte_load(14004) == 34) + (byte_load(14004) == 36))
        byte_store(14999, 11 * temp + byte_load(14999) * (temp == 0))
        ok = ok * ((temp == 0) + temp * (byte_load(14022) < 64))

        # Allocate leaves, binary expressions, statements or the final function.
        active = byte_load(15000)
        temp = (active == 1) + (active == 5) + (active == 6) + (active == 7) + (active == 8) + (active == 9)
        temp = temp + (active == 10) + (active == 11) + (active == 12) + (active == 15) + (active == 16)
        byte_store(14999, 5 * (ok * temp) + byte_load(14999) * ((ok * temp) == 0))
        ok = ok * ((temp == 0) + temp * (nodes < 512))
        byte_store(15009, temp * ok)
        index = byte_load(30000 + operators * 4) + 256 * byte_load(30001 + operators * 4)
        temp = byte_load(10002 + index * 6) + 256 * byte_load(10003 + index * 6)
        start = start * ((active == 1) + (active == 8) + (active == 9) + (active == 10) + (active == 11) + (active == 12) + (active == 15)) + temp * ((active == 5) + (active == 16))
        temp = byte_load(10004 + index * 6) + 256 * byte_load(10005 + index * 6)
        # Operator/callee spans retain both bytes of the token length.
        byte_store(15017, temp)
        byte_store(15020, temp / 256)
        index = pos + (pos < tokens)
        temp = byte_load(10002 + index * 6) + 256 * byte_load(10003 + index * 6)
        index = (active == 9) * (byte_load(15016) == 37)
        start = start * (index == 0) + temp * index
        temp = byte_load(14008) + 256 * byte_load(14009)
        start = start + temp * (active == 6)
        temp = byte_load(14020) + 256 * byte_load(14021)
        start = start + temp * (active == 7)
        kind = kind * ((active == 1) + (active == 8)) + byte_load(15006) * (active == 5)
        kind = kind + byte_load(14004) * (active == 6) + 33 * (active == 7) + byte_load(15016) * (active == 9)
        kind = kind + 39 * (active == 10) + 40 * (active == 11) + 41 * (active == 12) + 43 * (active == 15) + 42 * (active == 16)

        # Child operands are read before mutation; even inactive reads use sentinels.
        index = byte_load(33000 + values * 2) + 256 * byte_load(33001 + values * 2)
        temp = values - (values != 0)
        temp = byte_load(33000 + temp * 2) + 256 * byte_load(33001 + temp * 2)
        ch = (byte_load(14004) == 30) + (byte_load(14004) == 31)
        byte_store(15018, ch)
        temp = temp * (active == 5) + index * (active == 6) * (ch == 0)
        temp = temp + (byte_load(14006) + 256 * byte_load(14007)) * (active == 6) * ch
        temp = temp + (byte_load(14000) + 256 * byte_load(14001)) * (active == 7)
        temp = temp + (byte_load(36002 + operators * 6) + 256 * byte_load(36003 + operators * 6)) * ((active == 15) + (active == 16))
        byte_store(15024, temp)
        byte_store(15025, temp / 256)
        index = index * ((active == 5) + (active == 6) * ch + (active == 15))
        byte_store(15026, index)
        byte_store(15027, index / 256)

        nodes = nodes + byte_load(15009)
        index = (20000 + (nodes - 1) * 16) * byte_load(15009) + 65000 * (byte_load(15009) == 0)
        byte_store(index, kind)
        byte_store(index + 2, start)
        byte_store(index + 3, start / 256)
        temp = byte_load(10004 + pos * 6) + 256 * byte_load(10005 + pos * 6)
        ch = temp * ((active == 1) + (active == 8) + (active == 10) + (active == 11)) + (byte_load(15017) + 256 * byte_load(15020)) * ((active == 5) + (active == 16))
        temp = byte_load(14016) + 256 * byte_load(14017)
        ch = ch + temp * (active == 6) + 2 * (active == 7) + (1 + 3 * (byte_load(15016) == 37)) * (active == 9)
        ch = ch + (active == 12) + (active == 15)
        byte_store(index + 4, ch)
        byte_store(index + 5, ch / 256)
        byte_store(index + 6, byte_load(15024))
        byte_store(index + 7, byte_load(15025))
        byte_store(index + 8, byte_load(15026))
        byte_store(index + 9, byte_load(15027))

        temp = (active == 8) * ok
        index = 14006 * temp + 65000 * (temp == 0)
        byte_store(index, nodes)
        byte_store(index + 1, nodes / 256)
        values = values + ((active == 1) + (active == 16) - (active == 5) - (active == 15)) * ok
        temp = ((active == 1) + (active == 5) + (active == 16)) * ok
        index = (33000 + values * 2) * temp + 65000 * (temp == 0)
        byte_store(index, nodes)
        byte_store(index + 1, nodes / 256)

        temp = (active == 15) * ok
        index = (36002 + operators * 6) * temp + 65000 * (temp == 0)
        byte_store(index, nodes)
        byte_store(index + 1, nodes / 256)
        byte_store(index + 2, byte_load(index + 2) + temp)
        byte_store(14023, byte_load(14023) + (active == 11) * ok)

        # Push/pop operators without consuming the incoming token on reduction.
        temp = ((active == 2) + (active == 3) + (active == 14)) * ok
        operators = operators + temp
        index = (30000 + operators * 4) * temp + 65000 * (temp == 0)
